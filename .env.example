# autonomy-ladder environment configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# NEVER be committed (SPEC §11). Config is loaded via pydantic-settings, which
# fails loudly at startup naming any missing required variable.
#
# A reviewer can run `make setup && make test` and `make eval` with NO API key —
# evals replay cached fixtures. The key is only needed for live agent runs
# (`make demo`) and for regenerating fixtures.

# ---- Required for live runs only ----
ANTHROPIC_API_KEY=

# ---- Optional: observability (all have safe defaults) ----
# Where the JSONL telemetry export is written.
# AL_TELEMETRY_PATH=telemetry/spans.jsonl
# Emit OpenTelemetry spans to the console in addition to the JSONL file.
# AL_OTEL_CONSOLE_EXPORT=true

# ---- Optional: runtime paths (all have safe defaults) ----
# Append-only trust ledger location (SQLite).
# AL_LEDGER_PATH=runtime/ledger.sqlite
